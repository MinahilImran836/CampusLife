<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CampusLife" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">@font/cute_apricot</item>
        <item name="fontFamily">@font/cute_apricot</item>

        <item name="colorPrimary">#AACB73</item> <item name="colorPrimaryDark">#CDE990</item>
        <item name="colorAccent">#FFD4D4</item> <item name="android:windowBackground">#FFFFE8</item>
    </style>

    <style name="Theme.CampusLife.NoActionBar" parent="Theme.CampusLife">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.CampusLife.Dialog" parent="Theme.CampusLife">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>

        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>

        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

</resources>