<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFE8">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFE8"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="2000dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="CampusLife Assistant"
            android:textColor="#3A4F3A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/bg_header_pill"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:gravity="center" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFE8"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <EditText
            android:id="@+id/edtChatInput"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:hint="Ask your notes anything..."
            android:textColorHint="#9A9A9A"
            android:textColor="#333333"
            android:textSize="14sp"
            android:background="@drawable/bg_chat_input"
            android:paddingHorizontal="20dp"
            android:importantForAutofill="no"
            android:inputType="textLongMessage" />

        <ImageView
            android:id="@+id/btnSendChat"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_send_button"
            android:src="@drawable/ic_send_arrow"
            android:scaleType="centerInside"
            app:tint="#3A4F3A"
            android:contentDescription="Send Message Button" />
    </LinearLayout>
</LinearLayout>