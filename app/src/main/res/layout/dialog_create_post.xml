<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="30dp"
    app:cardElevation="0dp"
    android:layout_margin="16dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_form_card">

        <TextView
            android:text="Publish New Shared Note"
            android:textColor="#3A4F3A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Topic Title"
            android:background="@drawable/tab_pill"
            android:paddingStart="16dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/edtDialogContent"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Describe contents..."
            android:background="@drawable/tab_pill"
            android:padding="16dp"
            android:gravity="top"
            android:layout_marginBottom="16dp"/>

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/tab_pill"
            android:layout_marginBottom="16dp"
            android:entries="@array/categories_array" />

        <LinearLayout
            android:id="@+id/containerFilePreviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"/>

        <ImageView
            android:id="@+id/btnSelectAttachment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_attachment"
            android:background="@drawable/tab_pill"
            android:layout_gravity="end"
            android:layout_marginBottom="16dp"
            app:tint="#333333"/>

        <Button
            android:id="@+id/btnPublish"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:text="Publish Post"
            android:textAllCaps="false"
            android:background="@drawable/btn_save_style"
            android:textColor="#000000"
            android:textSize="18sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>