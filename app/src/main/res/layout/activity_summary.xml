<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFE8"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtSummaryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/cute_apricot"
        android:text="AI Productivity Summary"
        android:textColor="#333333"
        android:textSize="28sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="10dp">

                <ProgressBar
                    android:id="@+id/summaryChart"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/circular_progress" />

                <TextView
                    android:id="@+id/txtBigPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/cute_apricot"
                    android:text="0%"
                    android:textColor="#FFD4D4"
                    android:textSize="44sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtStatDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/cute_apricot"
                android:text="Tasks Completed: 0/0"
                android:textColor="#666666"
                android:textSize="18sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:backgroundTint="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@drawable/edit_text_pill"
                        android:backgroundTint="#E8F5E9"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/txtFocusMetric" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textSize="18sp" android:textStyle="bold" android:textColor="#4CAF50"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOCUS" android:textSize="8sp" android:textColor="#777777" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✨ Focus Persona" android:textSize="14sp" android:textStyle="bold" android:textColor="#AACB73"/>
                        <TextView android:id="@+id/txtAiPersona" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calculating habits..." android:textColor="#444444" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:backgroundTint="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@drawable/edit_text_pill"
                        android:backgroundTint="#FFF3E0"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/txtPunctualityMetric" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textSize="18sp" android:textStyle="bold" android:textColor="#FF9800"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VELOCITY" android:textSize="8sp" android:textColor="#777777" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏰ Punctuality Matrix" android:textSize="14sp" android:textStyle="bold" android:textColor="#AACB73"/>
                        <TextView android:id="@+id/txtAiPunctuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Checking timeline..." android:textColor="#444444" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:backgroundTint="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@drawable/edit_text_pill"
                        android:backgroundTint="#E1F5FE"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/txtLocationMetric" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#03A9F4"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SPOTS" android:textSize="8sp" android:textColor="#777777" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍 Location Logs" android:textSize="14sp" android:textStyle="bold" android:textColor="#AACB73"/>
                        <TextView android:id="@+id/txtAiLocations" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mapping hubs..." android:textColor="#444444" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnBack"
                android:layout_width="180dp"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_save_style"
                android:fontFamily="@font/cute_apricot"
                android:text="Dashboard"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>