<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFE8"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="32dp"
        android:fontFamily="@font/cute_apricot"
        android:text="Settings"
        android:textColor="#FFB6C1"
        android:textSize="32sp"
        android:textStyle="bold" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily Reminders"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Reminder Schedule"
        android:textSize="14sp"
        android:textColor="#888888"
        android:textAllCaps="true"
        android:letterSpacing="0.1"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSetReminder"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_save_style"
        android:text="Set Reminder Time"
        android:textAllCaps="false"
        android:fontFamily="@font/cute_apricot"
        android:textSize="18sp"
        android:textColor="#000000"
        android:elevation="2dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="App Version 1.0.0"
        android:textColor="#888888"
        android:textSize="12sp" />

</LinearLayout>